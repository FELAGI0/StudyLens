{
  "manifest_version": 3,
  "name": "StudyLens",
  "version": "1.0.0",
  "description": "Выделите область экрана с учебным материалом и получите объяснение решения",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://tokify.sale/*",
    "https://study-lens-backend.onrender.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-explain": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Захват и разбор (Объясни)"
    },
    "capture-short": {
      "suggested_key": { "default": "Ctrl+Shift+K" },
      "description": "Захват и краткий ответ"
    },
    "capture-detailed": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Захват и пошаговый разбор"
    },
    "capture-translate": {
      "suggested_key": { "default": "Ctrl+Shift+T" },
      "description": "Захват и перевод"
    },
    "capture-findbug": {
      "description": "Захват и поиск ошибок"
    }
  }
}